# Supabase — Trade Journal
# Copy to .env and fill in real values. .env is gitignored; this file is committed.

# Project URL and ref. Ref is the subdomain: https://<ref>.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Publishable key (sb_publishable_...). Safe for the client-side dashboard.
# Carries the `anon` Postgres role — RLS applies. Read-only in this app.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Secret key (sb_secret_...). SERVER ONLY — the GitHub Actions sync job.
# Bypasses RLS. Never ship to the browser, never commit.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
